<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES"/>

    <application
        android:allowBackup="true"
        android:label="Digital Parenting"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <!-- Child bootstrap: authenticate first, then route to pairing or home. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Child App Activities -->
        <activity android:name=".ui.WelcomeActivity"
            android:exported="false" />
        <activity android:name=".ui.PairingCodeActivity"
            android:exported="false" />
        <activity android:name=".ui.PermissionsSetupActivity"
            android:exported="false" />
        <activity android:name=".ui.HomeStatusActivity"
            android:exported="false" />
        <activity android:name=".ui.DiagnosticsActivity"
            android:exported="false" />
        <activity android:name=".ui.ActivityAlertsActivity"
            android:exported="false" />
        <activity android:name=".ui.BlockedActivity"
            android:exported="false" />
        <activity android:name=".ui.RequestMoreTimeActivity"
            android:exported="false" />

        <!-- Block Activity (Overlay) -->
        <activity android:name=".ui.BlockActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"/>

        <!-- Foreground Service -->
        <service
            android:name=".service.MonitoringService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>

        <!-- Boot Receiver -->
        <receiver android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>

        <!-- Child Accessibility Service -->
        <service
            android:name=".service.ChildAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

    </application>
</manifest>
