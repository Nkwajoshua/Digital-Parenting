rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAnonymousIdentity() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isParentIdentity() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isParent(parentUid) {
      return isParentIdentity() && request.auth.uid == parentUid;
    }

    function isChild(childUid) {
      return isAnonymousIdentity() && request.auth.uid == childUid;
    }

    function childDoc(childUid) {
      return get(/databases/$(database)/documents/children/$(childUid));
    }

    function parentOwnsChild(childUid) {
      return isParentIdentity()
        && exists(/databases/$(database)/documents/children/$(childUid))
        && childDoc(childUid).data.parentUid == request.auth.uid
        && childDoc(childUid).data.paired == true;
    }

    // Use the candidate/current resource directly for children collection reads.
    // Re-fetching the same wildcard document through get() can evaluate to null
    // during list/query authorization.
    function parentOwnsCurrentChild() {
      return isParentIdentity()
        && resource.data.parentUid == request.auth.uid
        && resource.data.paired == true;
    }

    match /parents/{parentUid} {
      allow read, write: if isParent(parentUid);
    }

    match /children/{childUid} {
      allow read: if isChild(childUid) || parentOwnsCurrentChild();

      // Child ownership is established only by the server-side pairing callable.
      allow create: if false;

      // Child-owned status and health updates only. Use affectedKeys(), not
      // changedKeys(), so newly added/removed unauthorized fields are denied too.
      allow update: if isChild(childUid)
        && resource.data.paired == true
        && request.resource.data.parentUid == resource.data.parentUid
        && request.resource.data.pairingCode == resource.data.pairingCode
        && request.resource.data.paired == resource.data.paired
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'deviceName',
          'platform',
          'lastHeartbeatAt',
          'monitoringActive',
          'batteryLevel',
          'charging',
          'appVersion',
          'deviceTime',
          'updatedAt',
          'fcmToken',
          'fcmTokenUpdatedAt',
          'permissionUsageAccess',
          'permissionOverlay',
          'permissionAccessibility',
          'permissionBatteryOptimization',
          'permissionNotifications',
          'accessibilityEnabled',
          'overlayPermissionGranted'
        ]);

      // Parent-managed profile/settings fields for an already linked child.
      allow update: if parentOwnsCurrentChild()
        && request.resource.data.parentUid == resource.data.parentUid
        && request.resource.data.paired == resource.data.paired
        && request.resource.data.pairingCode == resource.data.pairingCode
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'childName',
          'avatar',
          'timezone',
          'dailyLimitMinutes',
          'bedtimeStart',
          'bedtimeEnd',
          'schoolModeEnabled',
          'allowedApps',
          'blockedApps',
          'settings',
          'notes',
          'updatedAt'
        ]);

      allow delete: if false;

      match /commands/{commandId} {
        allow read: if isChild(childUid) || parentOwnsChild(childUid);

        // Commands are created only by the sendCommand callable after server-side
        // parent/child ownership validation. Admin SDK writes bypass these rules.
        allow create: if false;

        // The child may acknowledge only a currently pending command. It cannot
        // rewrite command payload/ownership or mutate terminal commands again.
        allow update: if isChild(childUid)
          && resource.data.status == 'pending'
          && request.resource.data.childUid == resource.data.childUid
          && request.resource.data.parentUid == resource.data.parentUid
          && request.resource.data.type == resource.data.type
          && request.resource.data.status in ['handled', 'failed']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'handledAt',
            'errorMessage',
            'updatedAt'
          ]);

        allow delete: if false;
      }
    }

    match /usage_sessions/{childUid}/sessions/{sessionId} {
      allow read: if isChild(childUid) || parentOwnsChild(childUid);
      allow create: if isChild(childUid)
        && exists(/databases/$(database)/documents/children/$(childUid))
        && childDoc(childUid).data.paired == true;
      allow update, delete: if false;
    }

    match /time_requests/{requestId} {
      // Paired children can request bounded extra time only for themselves.
      // Parent resolution is handled exclusively by resolveTimeRequest.
      allow create: if isChild(request.resource.data.childUid)
        && exists(/databases/$(database)/documents/children/$(request.auth.uid))
        && childDoc(request.auth.uid).data.paired == true
        && request.resource.data.keys().hasAll([
          'childUid',
          'deviceName',
          'appName',
          'appPackage',
          'requestedMinutes',
          'approvedMinutes',
          'status',
          'parentResponse',
          'createdAt',
          'resolvedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'childUid',
          'deviceName',
          'appName',
          'appPackage',
          'requestedMinutes',
          'approvedMinutes',
          'status',
          'parentResponse',
          'createdAt',
          'resolvedAt',
          'updatedAt'
        ])
        && request.resource.data.deviceName is string
        && request.resource.data.appName is string
        && request.resource.data.appPackage is string
        && request.resource.data.requestedMinutes is int
        && request.resource.data.requestedMinutes > 0
        && request.resource.data.requestedMinutes <= 240
        && request.resource.data.approvedMinutes == null
        && request.resource.data.parentResponse == null
        && request.resource.data.resolvedAt == null
        && request.resource.data.status == 'pending';

      allow read: if isChild(resource.data.childUid)
        || parentOwnsChild(resource.data.childUid);

      // Child can mark a server-approved request as applied after updating its
      // local limit. No other client-side status transition is accepted.
      allow update: if isChild(resource.data.childUid)
        && resource.data.status == 'approved'
        && request.resource.data.status == 'applied'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'appliedAt',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    match /pairing_codes/{code} {
      // Pairing code issuance and redemption are Admin SDK operations performed
      // by callable functions. A parent may read a code it owns so the dashboard
      // can show live pending/used state; codes can never be listed by clients.
      allow get: if isParent(resource.data.parentUid);
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /parent_notifications/{notificationId} {
      allow read: if isParent(resource.data.parentUid);

      // Notifications are created by Cloud Functions. Parents may only change
      // their own read-state metadata.
      allow create: if false;

      allow update: if isParent(resource.data.parentUid)
        && request.resource.data.parentUid == resource.data.parentUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'read',
          'readAt',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    match /command_audit/{auditId} {
      allow read: if resource.data.childUid is string
        && parentOwnsChild(resource.data.childUid);

      // Admin SDK only (Cloud Functions) writes audit docs.
      allow create, update, delete: if false;
    }

    // Server-only abuse-prevention state (for example pairing issuance throttles).
    match /control_rate_limits/{rateLimitId} {
      allow read, write: if false;
    }
  }
}
