rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isParent(parentUid) {
      return signedIn() && request.auth.uid == parentUid;
    }

    function isChild(childUid) {
      return signedIn() && request.auth.uid == childUid;
    }

    function childDoc(childUid) {
      return get(/databases/$(database)/documents/children/$(childUid));
    }

    function parentOwnsChild(childUid) {
      return signedIn()
        && exists(/databases/$(database)/documents/children/$(childUid))
        && childDoc(childUid).data.parentUid == request.auth.uid;
    }

    function pairingDoc(code) {
      return get(/databases/$(database)/documents/pairing_codes/$(code));
    }

    function validPendingPairing(code, parentUid) {
      return signedIn()
        && code is string
        && parentUid is string
        && exists(/databases/$(database)/documents/pairing_codes/$(code))
        && pairingDoc(code).data.status == 'pending'
        && pairingDoc(code).data.parentUid == parentUid
        && pairingDoc(code).data.expiresAt > request.time;
    }

    function isAllowedCommandType(commandType) {
      return commandType in ['block_app', 'unblock_app', 'set_limit'];
    }

    function isAllowedRequestStatus(status) {
      return status in ['pending', 'approved', 'denied', 'applied'];
    }

    match /parents/{parentUid} {
      allow read, write: if isParent(parentUid);
    }

    match /children/{childUid} {
      allow read: if isChild(childUid) || parentOwnsChild(childUid);

      // MVP pairing path. The child may create only its own linked record and
      // only while presenting a currently valid parent-issued pairing code.
      allow create: if isChild(childUid)
        && request.resource.data.keys().hasAll([
          'parentUid',
          'paired',
          'pairedAt',
          'pairingCode',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'parentUid',
          'paired',
          'pairedAt',
          'pairingCode',
          'updatedAt',
          'deviceName',
          'platform',
          'monitoringActive',
          'lastHeartbeatAt',
          'batteryLevel',
          'charging',
          'appVersion',
          'deviceTime',
          'accessibilityEnabled',
          'overlayPermissionGranted'
        ])
        && request.resource.data.paired == true
        && validPendingPairing(
          request.resource.data.pairingCode,
          request.resource.data.parentUid
        );

      // Child-owned status and health updates only. Pairing ownership cannot be changed.
      allow update: if isChild(childUid)
        && request.resource.data.parentUid == resource.data.parentUid
        && request.resource.data.pairingCode == resource.data.pairingCode
        && request.resource.data.paired == resource.data.paired
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'deviceName',
          'platform',
          'lastHeartbeatAt',
          'monitoringActive',
          'batteryLevel',
          'charging',
          'appVersion',
          'deviceTime',
          'updatedAt',
          'fcmToken',
          'fcmTokenUpdatedAt',
          'permissionUsageAccess',
          'permissionOverlay',
          'permissionAccessibility',
          'permissionBatteryOptimization',
          'permissionNotifications',
          'accessibilityEnabled',
          'overlayPermissionGranted'
        ]);

      // Parent-managed settings for an already linked child.
      allow update: if parentOwnsChild(childUid)
        && request.resource.data.parentUid == resource.data.parentUid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'name',
          'childName',
          'avatar',
          'timezone',
          'dailyLimitMinutes',
          'bedtimeStart',
          'bedtimeEnd',
          'schoolModeEnabled',
          'allowedApps',
          'blockedApps',
          'settings',
          'notes',
          'updatedAt'
        ]);

      allow delete: if false;

      match /commands/{commandId} {
        allow read: if isChild(childUid) || parentOwnsChild(childUid);

        allow create: if parentOwnsChild(childUid)
          && request.resource.data.childUid == childUid
          && request.resource.data.parentUid == request.auth.uid
          && isAllowedCommandType(request.resource.data.type)
          && request.resource.data.status == 'pending'
          && request.resource.data.appPackage is string
          && (
            request.resource.data.type in ['block_app', 'unblock_app']
            ||
            (request.resource.data.type == 'set_limit'
              && request.resource.data.maxMinutes is int
              && request.resource.data.maxMinutes > 0)
          );

        // Child can only mark delivery/handling fields and cannot rewrite the command payload.
        allow update: if isChild(childUid)
          && request.resource.data.childUid == resource.data.childUid
          && request.resource.data.parentUid == resource.data.parentUid
          && request.resource.data.type == resource.data.type
          && request.resource.data.status in ['handled', 'failed']
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'status',
            'handledAt',
            'errorMessage',
            'updatedAt'
          ]);

        allow delete: if false;
      }
    }

    match /usage_sessions/{childUid}/sessions/{sessionId} {
      allow read: if isChild(childUid) || parentOwnsChild(childUid);
      allow create: if isChild(childUid);
      allow update, delete: if false;
    }

    match /time_requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.childUid == request.auth.uid
        && request.resource.data.status == 'pending';

      allow read: if signedIn()
        && (
          resource.data.childUid == request.auth.uid
          || parentOwnsChild(resource.data.childUid)
        );

      // Parent response-only updates.
      allow update: if signedIn()
        && parentOwnsChild(resource.data.childUid)
        && isAllowedRequestStatus(request.resource.data.status)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status',
          'parentResponse',
          'approvedMinutes',
          'resolvedAt',
          'updatedAt'
        ]);

      // Child can mark approved request as applied.
      allow update: if signedIn()
        && resource.data.childUid == request.auth.uid
        && resource.data.status == 'approved'
        && request.resource.data.status == 'applied'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status',
          'appliedAt',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    match /pairing_codes/{code} {
      // Parent creates a short-lived code for themselves. The document id and
      // embedded code must agree so clients cannot create ambiguous records.
      allow create: if signedIn()
        && request.resource.data.parentUid == request.auth.uid
        && request.resource.data.code == code
        && request.resource.data.status == 'pending';

      // A child may fetch a known pending code, but listing pairing codes is forbidden.
      allow get: if signedIn()
        && (resource.data.parentUid == request.auth.uid || resource.data.status == 'pending');
      allow list: if false;

      allow update: if signedIn() && (
        // Parent-maintained edits while still pending.
        (resource.data.parentUid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.parentUid == resource.data.parentUid)
        ||
        // Child redemption path: pending -> used, with ownership fields immutable.
        (resource.data.status == 'pending'
          && request.resource.data.status == 'used'
          && request.resource.data.parentUid == resource.data.parentUid
          && request.resource.data.code == resource.data.code
          && request.resource.data.usedByChildUid == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'status',
            'usedByChildUid',
            'usedAt',
            'updatedAt'
          ]))
      );

      allow delete: if false;
    }

    match /parent_notifications/{notificationId} {
      allow read: if signedIn() && resource.data.parentUid == request.auth.uid;

      // Parent-owned MVP notification creation only. Child-originated alerts
      // should move through Cloud Functions in the next backend-hardening phase.
      allow create: if signedIn()
        && request.resource.data.parentUid == request.auth.uid;

      allow update: if signedIn()
        && resource.data.parentUid == request.auth.uid
        && request.resource.data.parentUid == resource.data.parentUid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'read',
          'readAt',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    match /command_audit/{auditId} {
      allow read: if signedIn()
        && resource.data.childUid is string
        && parentOwnsChild(resource.data.childUid);

      // Admin SDK only (Cloud Functions) writes audit docs.
      allow create, update, delete: if false;
    }
  }
}
